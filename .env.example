# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://pharmachain:pharmachain@localhost:5432/pharmachain"

# ─── Auth (shared by web + api; generate with: openssl rand -base64 32) ──────
AUTH_SECRET="change-me-generate-a-random-32-byte-secret"
# Auth.js base URL of the web app
AUTH_URL="http://localhost:3000"

# ─── API service ─────────────────────────────────────────────────────────────
API_PORT="3001"
# Origins allowed by the API's CORS policy (comma-separated)
CORS_ORIGINS="http://localhost:3000"
# Public URL of the web app (used in email deep links)
APP_URL="http://localhost:3000"
# Run scheduled jobs inside the API process (true) or as a separate worker
JOBS_IN_PROCESS="true"

# ─── Web app ─────────────────────────────────────────────────────────────────
# URL the web server uses to reach the API (server-side + proxy route)
API_URL="http://localhost:3001"

# ─── Object storage: Cloudflare R2 ───────────────────────────────────────────
# Production uses Cloudflare R2, reached over its S3-compatible API (which is
# why the client is an S3 signer). docker-compose ships MinIO as the local
# stand-in, configured through these same variables.
#
# In production:
#   R2_ENDPOINT="https://<cloudflare-account-id>.r2.cloudflarestorage.com"
#   R2_REGION="auto"          # R2 requires "auto"; it has no AWS regions
#   R2_BUCKET="pharmachain-documents"
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY  → an R2 API token
#
# All five are REQUIRED in production — the API refuses to boot on these dev
# defaults rather than silently presigning http://localhost:9000. The bucket
# needs no CORS rule: upload bytes go through the API, not the browser.
R2_ENDPOINT="http://localhost:9000"
R2_REGION="auto"
R2_BUCKET="pharmachain-documents"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"

# ─── Email (console = log to stdout for dev; resend = Resend HTTP API) ───────
EMAIL_PROVIDER="console"
EMAIL_FROM="PharmaChain <no-reply@pharmachain.local>"
RESEND_API_KEY=""

# ─── WhatsApp notifications (console stub in Phase 1) ────────────────────────
WHATSAPP_PROVIDER="console"

# ─── Seed (local/dev only — change before seeding anything shared) ───────────
SEED_SUPER_ADMIN_EMAIL="admin@pharmachain.local"
SEED_SUPER_ADMIN_PASSWORD="admin-ChangeMe-1"

